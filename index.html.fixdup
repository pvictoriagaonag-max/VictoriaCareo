<!-- ===================================================
        MODAL PRODUCTO
=================================================== -->

<div class="product-modal" id="productModal">

    <div class="product-modal-overlay"></div>

    <div class="product-modal-content">

        <button class="close-modal" id="closeModal">

        </button>

        <div class="modal-grid">

            <!-- Imagen -->

            <div class="modal-image">

                <img
                    id="modalImage"
                    src=""
                    alt="Producto Victoria Care">

            </div>

            <!-- Información -->

            <div class="modal-info">

                <span id="modalCategory"
                      class="modal-category">

                </span>

                <h2 id="modalTitle">

                </h2>

                <div id="modalPrice"
                     class="modal-price">

                </div>

                <p id="modalDescription">

                </p>

                <h4>

                    Beneficios

                </h4>

                <ul class="modal-benefits">

                    <li>✓ Producto recomendado durante la consulta.</li>

                    <li>✓ Ideal para el cuidado diario.</li>

                    <li>✓ Elaborado con ingredientes de alta calidad.</li>

                </ul>

                <h4>

                    Cantidad

                </h4>

                <div class="quantity-selector">

                    <button id="minusQty">

                        −

                    </button>

                    <span id="quantity">

                        1

                    </span>

                    <button id="plusQty">

                        +

                    </button>

                </div>

                <button class="buy-product" id="openCheckout">

                Continuar con mi compra
            </button>

            </div>

        </div>

    </div>

</div>
<!-- ===================================================
        CHECKOUT PREMIUM
=================================================== -->

<div class="checkout-modal" id="checkoutModal">

    <div class="checkout-overlay"></div>

    <div class="checkout-content">

        <button class="close-checkout" id="closeCheckout">
            ✕
        </button>

        <div class="checkout-header">

            <span>RESUMEN DEL PEDIDO</span>

            <h2>Finaliza tu compra</h2>

            <p>
                Completa tus datos para generar tu pedido.
            </p>

        </div>

        <!-- =====================================
                RESUMEN
        ====================================== -->

        <div class="checkout-summary">

            <img
                id="checkoutImage"
                src=""
                alt="Producto">

            <h3 id="checkoutTitle"></h3>

            <div
                id="checkoutPrice"
                class="checkout-price">
            </div>

            <div class="checkout-qty">

                <button id="checkoutMinus">−</button>

                <span id="checkoutQuantity">1</span>

                <button id="checkoutPlus">+</button>

            </div>

            <div class="checkout-total">

                <span>Total</span>

                <strong id="checkoutTotal"></strong>

            </div>

        </div>

        <!-- =====================================
                FORMULARIO
        ====================================== -->

        <div class="checkout-form">

            <h3>Tus datos</h3>

            <input
                type="text"
                id="customerName"
                placeholder="Nombre completo">

            <input
                type="tel"
                id="customerPhone"
                placeholder="Teléfono">

            <input
                type="email"
                id="customerEmail"
                placeholder="Correo electrónico">

            <h3>Entrega</h3>

            <label>
                <input
                    type="radio"
                    name="delivery"
                    value="consultorio"
                    checked>

                Recoger en consultorio
            </label>

            <label>
                <input
                    type="radio"
                    name="delivery"
                    value="envio">

                Envío a domicilio
            </label>

            <div
                id="shippingFields"
                class="shipping-fields">

                <input type="text" id="state" placeholder="Estado">
                <input type="text" id="city" placeholder="Municipio">
                <input type="text" id="zip" placeholder="Código Postal">
                <input type="text" id="street" placeholder="Calle">
                <input type="text" id="number" placeholder="Número">

                <textarea
                    id="reference"
                    placeholder="Referencias"></textarea>

            </div>

            <button
                class="continue-payment"
                id="continuePayment">

                Continuar al pago

            </button>

        </div>

    </div>

</div>
        <!-- ===================================================
        PAGO
=================================================== -->

<div class="payment-modal" id="paymentModal">

    <div class="checkout-overlay"></div>

    <div class="payment-content">

        <button
            class="close-checkout"
            id="closePayment">
            ✕
        </button>

        <span class="section-tag">
            TRANSFERENCIA BANCARIA
        </span>

        <h2>
            Finaliza tu compra
        </h2>

        <p>
            Realiza la transferencia y envíame tu comprobante.
        </p>

        <div class="bank-card">

            <h3>BANORTE</h3>

            <p>
                <strong>Titular</strong><br>
                Perla Victoria Gaona Gutiérrez
            </p>

            <p>
                <strong>CLABE</strong>
            </p>

            <div class="clabe-box">

                <span id="clabe">
                    072470013546661558
                </span>

                <button id="copyClabe">
                    Copiar
                </button>

            </div>

        </div>

        <button
            class="continue-payment"
            id="sendWhatsapp">

            He realizado la transferencia

        </button>

    </div>

</div>
<!-- ===================================================
        CONFIRMACIÓN DEL PEDIDO
=================================================== -->

<div class="success-modal" id="successModal">

    <div class="checkout-overlay"></div>

    <div class="success-content">

        <div class="success-icon">
            ✓
        </div>

        <span class="section-tag">
            PEDIDO LISTO
        </span>

        <h2>
            ¡Gracias por tu compra!
        </h2>

        <p>
            Tu pedido ha sido preparado correctamente.
            El siguiente paso es enviarme tu comprobante.
        </p>

        <button
            class="continue-payment"
            id="confirmWhatsapp">

            Enviar comprobante por WhatsApp

        </button>

    </div>

</div>



 
